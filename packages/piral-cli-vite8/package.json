{
  "name": "piral-cli-vite8",
  "version": "1.0.0",
  "description": "Provides debug and build capabilities for pilets and Piral instances using Vite v8.",
  "keywords": [
    "piral-cli",
    "piral",
    "plugin",
    "vite",
    "vite8",
    "rolldown",
    "build",
    "debug",
    "bundle"
  ],
  "author": "smapiot",
  "homepage": "https://piral.io",
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "src"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/smapiot"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smapiot/piral-cli-vite8.git"
  },
  "bugs": {
    "url": "https://github.com/smapiot/piral-cli-vite8/issues"
  },
  "scripts": {
    "build": "npm run transpile && npm run bundle",
    "transpile": "tsc",
    "bundle": "esbuild src/index.ts --platform=node --bundle --external:piral-cli --outfile=lib/index.js"
  },
  "devDependencies": {
    "@types/babel__core": "^7",
    "esbuild": "0.27.4",
    "piral-cli": "1.12.2"
  },
  "dependencies": {
    "@babel/core": "^7",
    "@babel/plugin-transform-dynamic-import": "^7",
    "@babel/plugin-transform-modules-systemjs": "^7",
    "@jridgewell/sourcemap-codec": "^1.4.15",
    "cheerio": "^1",
    "magic-string": "^0.30.5",
    "sass": "^1",
    "vite": "^8",
    "vite-plugin-codegen": "^2",
    "vite-plugin-environment": "^1"
  }
}
